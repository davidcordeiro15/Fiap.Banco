@model IEnumerable<Fiap.Banco.API.Models.Agencia>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nmEndereco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.cep)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nmEndereco)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cep)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idAgencia">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idAgencia">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idAgencia">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
